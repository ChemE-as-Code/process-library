{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.cheme-as-code.org/schemas/families/v1.json",
  "title": "Process-family taxonomy (taxonomy/families.yaml)",
  "description": "Process families with their ISIC Rev.4 and NACE Rev. 2 classes. process.schema.json lists the same slugs as the enum of families.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groups", "families"],
  "properties": {
    "schema": {"const": "cheme-as-code/families/v1"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title"],
        "properties": {"slug": {"$ref": "#/$defs/slug"}, "title": {"type": "string"}}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "group", "isic"],
        "properties": {
          "slug": {"$ref": "#/$defs/slug"},
          "title": {"type": "string"},
          "group": {"$ref": "#/$defs/slug"},
          "isic": {"description": "ISIC Rev.4 classes (4 digits).", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d{4}$"}},
          "nace": {"description": "NACE Rev. 2 classes (NN.NN).", "type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d{2}\\.\\d{2}$"}},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {"slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
}
