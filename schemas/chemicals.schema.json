{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.cheme-as-code.org/schemas/chemicals/v1.json",
  "title": "Chemical identity registry (chemicals/chemicals.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chemicals"],
  "properties": {
    "schema": {"const": "cheme-as-code/chemicals/v1"},
    "chemicals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "kind"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "kind": {"enum": ["substance", "mixture", "utility"]},
          "formula": {"type": "string"},
          "cas": {"type": "string", "pattern": "^\\d{2,7}-\\d{2}-\\d$"},
          "chebi": {"type": "string", "pattern": "^CHEBI:\\d+$"},
          "inchikey": {"type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"},
          "synonyms": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    }
  }
}
