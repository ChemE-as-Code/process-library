{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.cheme-as-code.org/schemas/chemicals/v2.json",
  "title": "Chemicals and products registry (chemicals/chemicals.yaml)",
  "description": "Substances, mixtures and utilities that processes name, with their grades (a product in a defined state and purity), properties for LCI (each with value, unit and source), classifications and crosswalks to other databases' reference product names. v1 registries (identity only) still validate: every v2 field is optional. Rules: docs/registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chemicals"],
  "properties": {
    "schema": {"enum": ["cheme-as-code/chemicals/v2", "cheme-as-code/chemicals/v1"]},
    "chemicals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "kind"],
        "properties": {
          "slug": {"$ref": "#/$defs/slug"},
          "name": {"type": "string"},
          "kind": {"enum": ["substance", "mixture", "utility"]},
          "formula": {"type": "string", "description": "Formula of elements and counts, e.g. CO2, CH4 (no charges, no hydrates)."},
          "cas": {"type": "string", "pattern": "^\\d{2,7}-\\d{2}-\\d$", "description": "CAS RN; the build checks its check digit."},
          "chebi": {"type": "string", "pattern": "^CHEBI:\\d+$"},
          "inchikey": {"type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$", "description": "Standard InChIKey; the build checks the standard flag and version (...SA-...)."},
          "pubchem_cid": {"type": "integer", "minimum": 1},
          "ec_number": {"type": "string", "pattern": "^\\d{3}-\\d{3}-\\d$"},
          "synonyms": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"},
          "classification": {"$ref": "#/$defs/classification"},
          "crosswalk": {"$ref": "#/$defs/crosswalk"},
          "properties": {"$ref": "#/$defs/properties"},
          "composition": {"$ref": "#/$defs/composition"},
          "grades": {
            "description": "Products of this substance in a defined state and purity, named <slug>/<grade> by flows.",
            "type": "array",
            "items": {"$ref": "#/$defs/grade"}
          }
        }
      }
    },
    "flow_grades": {
      "description": "Grades of flows whose process.yaml names only the substance: \"<process-id>/<inventory_key>\" -> \"<slug>/<grade>\".",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z][a-z-]*:[A-Za-z0-9_.\\-]+$"},
      "additionalProperties": {"$ref": "#/$defs/grade_ref"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "grade_slug": {"type": "string", "pattern": "^[a-z0-9]+([-.][a-z0-9]+)*$"},
    "grade_ref": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+([-.][a-z0-9]+)*$"},
    "source": {"type": "string", "minLength": 3, "description": "Where the value comes from; a derived value says how."},
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {"value": {"type": "number"}, "unit": {"type": "string"}, "note": {"type": "string"}}
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpc": {"type": "string", "pattern": "^\\d{5}$", "description": "UN CPC Ver. 2.1 subclass."},
        "hs": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}$", "description": "HS 2022 subheading, e.g. 2804.40."}
      }
    },
    "crosswalk": {
      "description": "Reference product names in other databases. Names only, no data (licence rule, CLAUDE.md). A name belongs to one registry entry.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecoinvent": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "ef": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "source"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "conditions": {"type": "string"},
        "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "source": {"$ref": "#/$defs/source"},
        "note": {"type": "string"}
      }
    },
    "properties": {
      "description": "Properties for LCI, each with value, unit and source. Units are fixed per property so that values compare.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "molar_mass": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "g/mol"}}}]},
        "elemental_composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "source"],
          "properties": {
            "value": {"type": "object", "propertyNames": {"pattern": "^[A-Z][a-z]?$"}, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
            "unit": {"const": "kg/kg"},
            "source": {"$ref": "#/$defs/source"},
            "note": {"type": "string"}
          }
        },
        "carbon_content": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "kg/kg"}, "value": {"minimum": 0, "maximum": 1}}}]},
        "biogenic_carbon_fraction": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "kg/kg"}, "value": {"minimum": 0, "maximum": 1}}}], "description": "Share of the carbon that is biogenic (kg biogenic C per kg C)."},
        "lhv": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "MJ/kg"}}}]},
        "hhv": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "MJ/kg"}}}]},
        "density": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "kg/m3"}}, "required": ["conditions"]}]},
        "standard_chemical_exergy": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "kJ/mol"}}}]},
        "exergy": {"allOf": [{"$ref": "#/$defs/property"}, {"properties": {"unit": {"const": "kJ/kg"}}, "required": ["conditions"]}], "description": "Specific exergy (chemical + physical) at the stated state, dead state 298.15 K, 101.325 kPa: what exergy allocation weighs a grade by."},
        "price": {"$ref": "#/$defs/price"}
      }
    },
    "price": {
      "description": "A price from an open source only (e.g. Eurostat PRODCOM, UN Comtrade unit values).",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "currency", "year", "region", "source"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "pattern": "^[A-Z]{3}/(kg|t|m3|MWh|kWh)$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "year": {"type": "integer", "minimum": 1990, "maximum": 2100},
        "region": {"type": "string", "minLength": 2},
        "range": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "source": {"$ref": "#/$defs/source"},
        "note": {"type": "string"}
      }
    },
    "composition": {
      "description": "Typical composition of a mixture or grade, with its source. Each component is a registry slug (chemical) or a free name (component), with a value or a range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "components", "source"],
      "properties": {
        "basis": {"enum": ["mol", "mass", "vol"]},
        "of": {"type": "string"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit"],
            "oneOf": [{"required": ["chemical"]}, {"required": ["component"]}],
            "anyOf": [{"required": ["value"]}, {"required": ["range"]}],
            "properties": {
              "chemical": {"$ref": "#/$defs/slug"},
              "component": {"type": "string"},
              "value": {"type": "number", "minimum": 0},
              "range": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
              "unit": {"enum": ["mol%", "wt%", "vol%", "ppm(mol)", "ppm(wt)"]},
              "note": {"type": "string"}
            }
          }
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "bounded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "bound"],
      "properties": {
        "component": {"type": "string"},
        "value": {"type": "number", "minimum": 0},
        "unit": {"enum": ["mol%", "wt%", "vol%", "ppm(mol)", "ppm(wt)"]},
        "bound": {"enum": ["min", "max", "nominal"]}
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "phase"],
      "properties": {
        "slug": {"$ref": "#/$defs/grade_slug"},
        "name": {"type": "string", "description": "Reference product name in the LCI export."},
        "phase": {"enum": ["gas", "liquid", "solid", "solution", "supercritical", "none"]},
        "purity": {"$ref": "#/$defs/bounded"},
        "concentration": {"allOf": [{"$ref": "#/$defs/bounded"}], "description": "Of a solution, e.g. 50 wt% NaOH."},
        "impurities": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/bounded"}, {"required": ["component"]}]}},
        "state": {
          "description": "Reference state of the grade.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pressure": {"allOf": [{"$ref": "#/$defs/quantity"}, {"properties": {"unit": {"enum": ["barg", "bara"]}}}]},
            "temperature": {"allOf": [{"$ref": "#/$defs/quantity"}, {"properties": {"unit": {"enum": ["degC", "K"]}}}]},
            "note": {"type": "string"}
          }
        },
        "composition": {"$ref": "#/$defs/composition"},
        "properties": {"$ref": "#/$defs/properties"},
        "classification": {"$ref": "#/$defs/classification"},
        "crosswalk": {"$ref": "#/$defs/crosswalk"},
        "source": {"$ref": "#/$defs/source"},
        "note": {"type": "string"}
      }
    }
  }
}
